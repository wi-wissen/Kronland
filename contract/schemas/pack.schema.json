{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronland.wi7.net/contract/schemas/pack.schema.json",
  "title": "kronland-pack",
  "description": "pack.json of a level pack. All other files are named after their SHA-256 and never change; the SHA-256 of pack.json is the state of the pack. Levels are kronland-scenario files (scenario.schema.json).",
  "type": "object",
  "required": ["format", "version", "id", "title", "levels"],
  "properties": {
    "format": { "const": "kronland-pack" },
    "version": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/packId" },
    "title": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "author": { "type": "string", "maxLength": 100 },
    "license": { "type": "string", "maxLength": 100, "description": "SPDX identifier or text; missing = no license given." },
    "minClient": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "kind": { "enum": ["first", "stories", "code"], "description": "Library tab (like the catalog entry; the catalog wins)." },
    "difficulty": { "enum": ["easy", "normal", "hard"] },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 6000 },
    "preview": { "$ref": "#/$defs/mediaName", "description": "File name from `media`." },
    "levels": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "required": ["id", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[\\w-]+$", "maxLength": 64 },
          "file": { "type": "string", "pattern": "^[0-9a-f]{64}\\.json$" }
        },
        "additionalProperties": false
      }
    },
    "media": {
      "type": "object", "maxProperties": 500,
      "patternProperties": {
        "^[0-9a-f]{64}\\.(png|jpe?g|webp|mp3|ogg|glb)$": {
          "type": "object", "required": ["type", "bytes"],
          "properties": {
            "type": { "enum": ["image/png", "image/jpeg", "image/webp", "audio/mpeg", "audio/ogg", "model/gltf-binary"] },
            "bytes": { "type": "integer", "minimum": 0, "maximum": 20000000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "packId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 64 },
    "mediaName": { "type": "string", "pattern": "^[0-9a-f]{64}\\.(png|jpe?g|webp|mp3|ogg|glb)$" },
    "text": {
      "type": "object", "required": ["de", "en"],
      "properties": { "de": { "type": "string", "maxLength": 2000 }, "en": { "type": "string", "maxLength": 2000 } },
      "additionalProperties": false
    }
  }
}
