{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronland.wi7.net/contract/schemas/scenario.schema.json",
  "title": "kronland-scenario (top level)",
  "description": "Top-level fields of a level (docs/SKRIPTE.md). The authoritative check is validateScenario() in src/sim/scripting/scenario.js; this schema only guards the envelope so that servers can reject obvious junk. Unknown fields are allowed.",
  "type": "object",
  "required": ["format", "version", "id", "players", "sections"],
  "properties": {
    "format": { "const": "kronland-scenario" },
    "version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[\\w-]+$", "maxLength": 64 },
    "kind": { "enum": ["adventure", "mission", "campaign", "tutorial"] },
    "end": { "enum": ["objectives", "script"] },
    "difficulty": { "enum": ["easy", "normal", "hard"], "description": "Optional, shown in the library and used by its filters." },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 6000, "description": "Optional, estimated play time in minutes." },
    "title": { "$ref": "#/$defs/anyText" },
    "summary": { "$ref": "#/$defs/anyText" },
    "briefing": { "$ref": "#/$defs/anyText" },
    "world": { "type": "object" },
    "players": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "required": ["kind"] } },
    "sections": {
      "type": "array", "maxItems": 32,
      "items": { "type": "object", "required": ["id", "code"], "properties": { "id": { "type": "string" }, "code": { "type": "string", "maxLength": 200000 } } }
    }
  },
  "$defs": {
    "anyText": { "anyOf": [{ "type": "string", "maxLength": 4000 }, { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4000 } }] }
  }
}
